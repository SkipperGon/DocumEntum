@page "/Account/Manage"

@using Microsoft.AspNetCore.Identity
@using DocumEntum.Data
@using DocumEntum.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject ICurrentUserService CurrentUserService
@inject IOrganizationService OrgService

<PageTitle>Мой профиль</PageTitle>

<h3>Профиль пользователя</h3>

<StatusMessage Message="@statusMessage" />

<div class="row">
    <div class="col-md-6">
        <table class="table table-dark">
            <tr>
                <th>Логин</th>
                <td>@username</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@email</td>
            </tr>
            <tr>
                <th>Полное имя</th>
                <td>@(fullName ?? "—")</td>
            </tr>
            <tr>
                <th>Роль</th>
                <td>@roleName</td>
            </tr>
            @if (isEmployee)
            {
                <tr>
                    <th>Отдел</th>
                    <td>@departmentName</td>
                </tr>
                <tr>
                    <th>Должность</th>
                    <td>@positionTitle</td>
                </tr>
            }
        </table>

        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="/" />
            <button type="submit" class="btn btn-danger">Выйти</button>
        </form>
    </div>
</div>

@code {
    private string? statusMessage;
    private string? username;
    private string? email;
    private string? roleName;
    private string? fullName;
    private bool isEmployee;
    private string? departmentName;
    private string? positionTitle;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        username = user.UserName;
        email = user.Email ?? "не указан";
        var roles = await UserManager.GetRolesAsync(user);
        var roleEn = roles.FirstOrDefault() ?? "Нет роли";
        roleName = TranslateRole(roleEn);
        isEmployee = roleEn == "Employee";

        if (isEmployee)
        {
            var emp = await CurrentUserService.GetCurrentEmployeeAsync();
            fullName = emp?.FullName;
            if (emp != null)
            {
                var positions = await CurrentUserService.GetCurrentPositionsAsync();
                var firstPos = positions.FirstOrDefault();
                if (firstPos?.Position != null)
                {
                    departmentName = firstPos.Position.Department?.Name ?? "Не указан";
                    positionTitle = firstPos.Position.Title;
                }
                else
                {
                    departmentName = "Не назначен";
                    positionTitle = "Не назначена";
                }
            }
            else
            {
                departmentName = "Сотрудник не найден";
                positionTitle = "Сотрудник не найден";
            }
        }
    }

    private string TranslateRole(string roleEn) => roleEn switch
    {
        "Admin" => "Администратор",
        "Employee" => "Сотрудник",
        "SuperAdmin" => "Главный администратор",
        _ => roleEn
    };
}