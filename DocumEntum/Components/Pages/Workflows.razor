@page "/Workflows"
@rendermode InteractiveServer
@attribute [Authorize]
@using DocumEntum.Data
@using DocumEntum.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject IDocumentService DocumentService
@inject IWorkflowService WorkflowService
@inject ICurrentUserService CurrentUserService

<PageTitle>Процессы по документам</PageTitle>

<h1 class="mb-3">Процессы по документам</h1>

<p class="text-muted mb-4">
    Документы в активном бизнес-процессе (ещё не утверждённые).
    Утверждённые документы — в <a href="Documents">разделе «Документы»</a>.
</p>

@if (currentEmployee != null)
{
    <button type="button" class="btn btn-primary mb-3" @onclick="OpenStartModal">Новый процесс</button>
}
else
{
    <p class="text-muted small mb-3">Начать процесс могут только пользователи, привязанные к карточке сотрудника.</p>
}

@if (loadError != null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (isLoading)
{
    <p>Загрузка...</p>
}
else if (documents.Count == 0)
{
    <p class="text-muted">Нет документов в процессе.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Тип</th>
                    <th>Процесс</th>
                    <th>Статус</th>
                    <th>Запроситель</th>
                    <th>Создан</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in documents)
                {
                    <tr>
                        <td>
                            @doc.Title
                            @if (doc.ReplacesDocumentId.HasValue)
                            {
                                <span class="badge bg-secondary ms-1">изменение №@doc.ReplacesDocumentId</span>
                            }
                        </td>
                        <td>@doc.DocumentType?.Name</td>
                        <td>@doc.Workflow?.Name</td>
                        <td>@doc.CurrentState?.Name</td>
                        <td>@doc.Author?.FullName</td>
                        <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            @if (!string.IsNullOrEmpty(doc.StoredFileName))
                            {
                                <a class="btn btn-sm btn-outline-primary me-1" href="@($"/api/documents/{doc.Id}/download")" target="_blank">Скачать</a>
                            }
                            @if (!isAdmin)
                            {
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenManageModal(doc)">Открыть</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Модальное окно старта нового процесса *@
@if (showStartModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(startModalStep == 1 ? "Новый процесс" : "Первый переход")</h5>
                    <button type="button" class="btn-close" @onclick="CancelStartWizard"></button>
                </div>
                @if (startModalStep == 1)
                {
                    <EditForm Model="startModel" OnValidSubmit="SubmitStartProcessStep1">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            @if (startModalError != null)
                            {
                                <div class="alert alert-danger">@startModalError</div>
                            }
                            @if (startableWorkflows.Count == 0)
                            {
                                <p class="text-muted">Нет активных процессов, которые вы можете начать.</p>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <label class="form-label">Бизнес-процесс</label>
                                    <InputSelect @bind-Value="startModel.WorkflowId" class="form-select">
                                        <option value="0">— выберите процесс —</option>
                                        @foreach (var w in startableWorkflows)
                                        {
                                            <option value="@w.Id">@w.Name (@w.DocumentType?.Name)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => startModel.WorkflowId" />
                                </div>

                                var selectedWf = startableWorkflows.FirstOrDefault(w => w.Id == startModel.WorkflowId);
                                var initialSt = selectedWf?.States.FirstOrDefault(s => s.IsInitial);
                                bool canEditOnStart = initialSt?.CanEdit ?? false;


                                <div class="mb-3">
                                    <label class="form-label">Название документа</label>
                                    <InputText @bind-Value="startModel.Title" class="form-control" maxlength="500" />
                                    <ValidationMessage For="() => startModel.Title" />
                                </div>

                                @if (startModel.WorkflowId > 0)
                                {
                                    @if (canEditOnStart)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">Файл</label>
                                            <InputFile class="form-control" OnChange="OnStartFileSelected" accept="*/*" />
                                            @if (startFileName != null)
                                            {
                                                <small class="text-muted">Выбран: @startFileName</small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            На начальном этапе данного процесса прикрепление файла не требуется.
                                        </div>
                                    }
                                }

                                <div class="mb-3">
                                    <label class="form-label">Комментарий (необязательно)</label>
                                    <textarea class="form-control" @bind="startComment" rows="2" placeholder="Оставьте комментарий к первому действию..."></textarea>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelStartWizard">Отмена</button>
                            @if (startableWorkflows.Count > 0)
                            {
                                <button type="submit" class="btn btn-primary" disabled="@startSubmitting">
                                    @(startSubmitting ? "Создание…" : "Далее")
                                </button>
                            }
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="modal-body">
                        <p class="mb-2">Выберите действие для перехода с начального этапа.</p>
                        @if (transitionApplyError != null)
                        {
                            <div class="alert alert-danger">@transitionApplyError</div>
                        }
                        @if (pendingFirstTransitions.Count == 0)
                        {
                            <div class="alert alert-warning">Нет доступных переходов. Закройте окно или отмените — черновик будет удалён.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var t in pendingFirstTransitions)
                                {
                                    <button type="button" class="btn btn-primary" disabled="@transitionApplying" @onclick="async () => await ApplyFirstTransition(t.ActionName)">
                                        @t.ActionName
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelStartWizard" disabled="@transitionApplying">Отмена</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* Модальное окно управления существующим документом *@
@if (showManageModal && manageDoc != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Управление: @manageDoc.Title</h5>
                    <button type="button" class="btn-close" @onclick="CloseManageModal"></button>
                </div>
                <div class="modal-body">

                    @if (manageModalError != null)
                    {
                        <div class="alert alert-danger">@manageModalError</div>
                    }
                    @if (!string.IsNullOrEmpty(lastComment))
                    {
                        <div class="alert alert-info py-2">
                            <strong>Оставленый комментарий:</strong> @lastComment
                        </div>
                    }
                    @if (manageModalSuccess != null)
                    {
                        <div class="alert alert-success">@manageModalSuccess</div>
                    }

                    <p><strong>Этап:</strong> @manageDoc.CurrentState?.Name</p>
                    <p><strong>Текущий файл:</strong>
                        @if (!string.IsNullOrEmpty(manageDoc.StoredFileName))
                        {
                            <a href="@($"/api/documents/{manageDoc.Id}/download")" target="_blank">@manageDoc.FileName</a>
                        }
                        else
                        {
                            <span class="text-muted">Не прикреплен</span>
                        }
                    </p>

                    @* Панель загрузки нового файла (если доступно редактирование) *@
                    @if (manageCanEdit)
                    {
                        <div class="card mb-4">
                            <div class="card-body">
                                <h6 class="card-title">Обновить файл документа</h6>
                                <div class="input-group">
                                    <InputFile class="form-control" OnChange="OnManageFileSelected" accept="*/*" />
                                    <button class="btn btn-outline-secondary" @onclick="UpdateDocumentFile" disabled="@(manageFile == null || manageSubmitting)">
                                        Загрузить
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Комментарий к действию (необязательно)</label>
                        <textarea class="form-control" @bind="transitionComment" rows="2" placeholder="Ваш комментарий..."></textarea>
                    </div>
                    <h6 class="mt-2">Доступные переходы:</h6>
                    @if (manageTransitions.Count == 0)
                    {
                        <p class="text-muted">Ожидается действие от другого сотрудника.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var t in manageTransitions)
                            {
                                <button class="btn btn-success" disabled="@manageSubmitting" @onclick="() => ExecuteManageTransition(t.ActionName)">
                                    @t.ActionName
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManageModal" disabled="@manageSubmitting">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long MaxUploadBytes = 100L * 1024 * 1024;

    private bool isLoading = true;
    private string? loadError;
    private List<Document> documents = new();
    private Employee? currentEmployee;
    private bool isAdmin = false;
    
    private bool showStartModal;
    private int startModalStep = 1;
    private List<Workflow> startableWorkflows = new();
    private StartProcessForm startModel = new();
    private IBrowserFile? startFile;
    private string? startFileName;
    private string? startModalError;
    private bool startSubmitting;

    private int? createdDocumentId;
    private List<WorkflowTransition> pendingFirstTransitions = new();
    private bool transitionApplying;
    private string? transitionApplyError;

    // Управление
    private bool showManageModal;
    private Document? manageDoc;
    private List<WorkflowTransition> manageTransitions = new();
    private bool manageCanEdit;
    private IBrowserFile? manageFile;
    private string? manageModalError;
    private string? manageModalSuccess;
    private bool manageSubmitting;
    private string? transitionComment;
    private string? lastComment;
    private string? startComment;

    protected override async Task OnInitializedAsync()
    {
        currentEmployee = await CurrentUserService.GetCurrentEmployeeAsync();
        isAdmin = await CurrentUserService.IsAdminAsync();
        await ReloadDocumentsAsync();
    }

    private async Task ReloadDocumentsAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            documents = await DocumentService.GetWorkflowDocumentsAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    
    private async Task OpenStartModal()
    {
        if (currentEmployee == null) return;
        ResetStartModalState();
        startableWorkflows = await WorkflowService.GetStartableWorkflowsAsync();
        showStartModal = true;
    }

    private void ResetStartModalState()
    {
        startModalStep = 1;
        startModalError = null;
        startFile = null;
        startFileName = null;
        startModel = new StartProcessForm();
        startSubmitting = false;
        createdDocumentId = null;
        pendingFirstTransitions = new();
        transitionApplying = false;
        transitionApplyError = null;
        startComment = null;
    }

    private async Task CancelStartWizard()
    {
        if (startModalStep == 2 && createdDocumentId.HasValue)
        {
            try { await DocumentService.DeleteDocumentAsync(createdDocumentId.Value); } catch { }
        }
        showStartModal = false;
        ResetStartModalState();
        await ReloadDocumentsAsync();
    }

    private void OnStartFileSelected(InputFileChangeEventArgs e)
    {
        startModalError = null; 
        var file = e.FileCount > 0 ? e.File : null;
        if (file != null && file.Size > MaxUploadBytes)
        {
            startModalError = "Файл превышает максимально допустимый размер (100 МБ)";
            startFile = null;
            startFileName = null;
            return;
        }
        startFile = file;
        startFileName = startFile?.Name;
    }

    private async Task SubmitStartProcessStep1()
    {
        if (currentEmployee == null) return;

        startModalError = null;
        var title = startModel.Title.Trim();
        if (string.IsNullOrEmpty(title))
        {
            startModalError = "Укажите название документа.";
            return;
        }

        if (startModel.WorkflowId <= 0)
        {
            startModalError = "Выберите процесс.";
            return;
        }

        var workflow = startableWorkflows.FirstOrDefault(w => w.Id == startModel.WorkflowId);
        var initialState = workflow?.States.FirstOrDefault(s => s.IsInitial);
        bool canEditOnStart = initialState?.CanEdit ?? false;

        if (canEditOnStart && startFile == null)
        {
            startModalError = "Прикрепите файл (на данном этапе он обязателен).";
            return;
        }

        var previewTransitions = await WorkflowService.GetAvailableTransitionsFromInitialStateAsync(startModel.WorkflowId, currentEmployee.Id);
        if (previewTransitions.Count == 0)
        {
            startModalError = "С начального этапа нет доступных вам переходов. Проверьте права.";
            return;
        }

        startSubmitting = true;
        try
        {
            var deptId = await CurrentUserService.GetDepartmentIdAsync();
            Document doc;

            if (canEditOnStart && startFile != null)
            {
                await using var stream = startFile.OpenReadStream(MaxUploadBytes);
                doc = await DocumentService.CreateDocumentAsync(
                    title, startModel.WorkflowId, currentEmployee.Id, deptId,
                    new Dictionary<string, object>(), stream, startFile.Name, startFile.Size, startFile.ContentType);
            }
            else
            {
                doc = await DocumentService.CreateDocumentAsync(
                    title, startModel.WorkflowId, currentEmployee.Id, deptId,
                    new Dictionary<string, object>(), null, null, 0, null);
            }

            createdDocumentId = doc.Id;
            pendingFirstTransitions = await WorkflowService.GetAvailableTransitionsAsync(doc, currentEmployee.Id);

            startModalStep = 2;
        }
        catch (Exception ex)
        {
            startModalError = ex.Message;
        }
        finally
        {
            startSubmitting = false;
        }
    }

    private async Task ApplyFirstTransition(string actionName)
    {
        if (currentEmployee == null || !createdDocumentId.HasValue) return;

        transitionApplyError = null;
        transitionApplying = true;
        try
        {
            var doc = await DocumentService.GetDocumentAsync(createdDocumentId.Value);
            if (doc == null) { transitionApplyError = "Документ не найден."; return; }

            var ok = await WorkflowService.ExecuteTransitionAsync(doc, actionName, currentEmployee.Id, startComment);
            if (!ok) { transitionApplyError = "Не удалось выполнить переход."; return; }

            showStartModal = false;
            ResetStartModalState();
            await ReloadDocumentsAsync();
        }
        catch (Exception ex)
        {
            transitionApplyError = ex.Message;
        }
        finally
        {
            transitionApplying = false;
        }
    }


    private async Task OpenManageModal(Document doc)
    {
        if (currentEmployee == null) return;
        manageDoc = doc;
        manageTransitions = await WorkflowService.GetAvailableTransitionsAsync(doc, currentEmployee.Id);
        manageCanEdit = await WorkflowService.CanEditDocumentAsync(doc, currentEmployee.Id);

        // Запрашиваем последний комментарий из истории документа
        lastComment = await DocumentService.GetLastCommentForDocumentAsync(doc.Id);

        manageFile = null;
        manageModalError = null;
        manageModalSuccess = null;
        transitionComment = null;
        showManageModal = true;
    }

    private void CloseManageModal()
    {
        showManageModal = false;
        manageDoc = null;
    }

    private void OnManageFileSelected(InputFileChangeEventArgs e)
    {
        manageModalError = null;
        manageModalSuccess = null;
        var file = e.FileCount > 0 ? e.File : null;

        if (file != null && file.Size > MaxUploadBytes)
        {
            manageModalError = "Файл превышает максимально допустимый размер (100 МБ)";
            manageFile = null;
            return;
        }

        manageFile = file;
    }

    private async Task UpdateDocumentFile()
    {
        if (manageDoc == null || manageFile == null) return;
        manageSubmitting = true;
        manageModalError = null;
        manageModalSuccess = null;
        try
        {
            await using var stream = manageFile.OpenReadStream(MaxUploadBytes);
            await DocumentService.UpdateDocumentFileAsync(manageDoc.Id, stream, manageFile.Name, manageFile.Size, manageFile.ContentType);
            manageModalSuccess = "Файл успешно обновлен.";
            manageFile = null;
            
            // Обновляем состояние после загрузки
            await ReloadDocumentsAsync();
            manageDoc = documents.FirstOrDefault(d => d.Id == manageDoc.Id) ?? manageDoc;
        }
        catch (Exception ex)
        {
            manageModalError = ex.Message;
        }
        finally
        {
            manageSubmitting = false;
        }
    }

    private async Task ExecuteManageTransition(string actionName)
    {
        if (manageDoc == null || currentEmployee == null) return;
        manageSubmitting = true;
        manageModalError = null;
        try
        {
            var doc = await DocumentService.GetDocumentAsync(manageDoc.Id);
            if (doc == null) { manageModalError = "Документ не найден."; return; }

            var ok = await WorkflowService.ExecuteTransitionAsync(doc, actionName, currentEmployee.Id, transitionComment);
            if (!ok)
            {
                manageModalError = "Не удалось выполнить переход.";
                return;
            }

            CloseManageModal();
            await ReloadDocumentsAsync();
        }
        catch (Exception ex)
        {
            manageModalError = ex.Message;
        }
        finally
        {
            manageSubmitting = false;
        }
    }

    private sealed class StartProcessForm
    {
        [Range(1, int.MaxValue, ErrorMessage = "Выберите процесс")]
        public int WorkflowId { get; set; }

        [Required(ErrorMessage = "Укажите название")]
        [MaxLength(500)]
        public string Title { get; set; } = string.Empty;
    }
}