@page "/Documents"
@rendermode InteractiveServer
@attribute [Authorize]
@using DocumEntum.Data
@using DocumEntum.Services
@using Microsoft.AspNetCore.Authorization
@inject IDocumentService DocumentService
@inject IWorkflowService WorkflowService
@inject ICurrentUserService CurrentUserService
@inject IDocumentTypeService DocumentTypeService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Утверждённые документы</PageTitle>

<h1 class="mb-3">Утверждённые документы</h1>

<p class="text-muted mb-4">
    Каталог утверждённых документов. Черновики и согласование —
    <a href="Workflows">раздел «Процессы»</a>.
</p>

<!--фильтрация и сортировка-->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Тип документа</label>
                <select class="form-select" @bind="selectedDocumentTypeId">
                    <option value="0">Все типы</option>
                    @foreach (var dt in documentTypes)
                    {
                        <option value="@dt.Id">@dt.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Название документа</label>
                <input type="text" class="form-control" @bind="searchTitle" placeholder="Поиск по названию..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Сортировка</label>
                <select class="form-select" @bind="selectedSortOption">
                    <option value="@SortOption.TitleAsc">Название (А→Я)</option>
                    <option value="@SortOption.TitleDesc">Название (Я→А)</option>
                    <option value="@SortOption.CreatedDesc">Создано (сначала новые)</option>
                    <option value="@SortOption.CreatedAsc">Создано (сначала старые)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">Сбросить фильтры</button>
            </div>
        </div>
    </div>
</div>
@if (isAdmin)
{
    <div class="row mb-3">
        <div class="col-12">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="showDeletedToggle" checked="@showDeleted" @onchange="ToggleShowDeleted" />
                <label class="form-check-label text-muted" for="showDeletedToggle">Отображать удалённые документы</label>
            </div>
        </div>
    </div>
}

@if (loadError != null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (isLoading)
{
    <p>Загрузка...</p>
}
else if (documents.Count == 0)
{
    <p class="text-muted">Нет доступных утверждённых документов.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Тип</th>
                    <th>По запросу</th>
                    <th>Версия</th>
                    <th>Создан</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in sortedDocuments)
                {
                    <tr class="@(doc.IsDeleted ? "text-muted opacity-75" : "")">
                        <td>
                            @if (doc.IsDeleted)
                            {
                                <span class="badge bg-danger me-2">Удалён</span>
                            }
                            <span class="@(doc.IsDeleted ? "text-decoration-line-through" : "")">@doc.Title</span>
                        </td>
                        <td>@doc.DocumentType?.Name</td>
                        <td>@doc.Author?.FullName</td>
                        <td>@doc.ApprovedVersion</td>
                        <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            @if (!string.IsNullOrEmpty(doc.StoredFileName))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="@($"/api/documents/{doc.Id}/download")" target="_blank">Скачать</a>
                            }
                            @if (doc.ApprovedVersion > 1)
                            {
                                <button class="btn btn-sm btn-info ms-1" @onclick="() => OpenVersionsModal(doc)">Версии</button>
                            }
                            @if (currentEmployee != null && !doc.IsDeleted)
                            {
                                <button class="btn btn-sm btn-warning ms-1" @onclick="() => OpenUpdateModal(doc)">Обновить</button>
                            }
                            @if (isAdmin)
                            {
                                @if (doc.IsDeleted)
                                {
                                    <button class="btn btn-sm btn-success ms-1" @onclick="() => RestoreDoc(doc)">Восстановить</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeleteDoc(doc)">Удалить</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="text-muted mt-2 small">Показано @filteredDocuments.Count из @documents.Count записей</div>
    @* мадал.окно *@
    @if (showUpdateModal && docToUpdate != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Обновление документа: @docToUpdate.Title</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseUpdateModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (updateModalError != null)
                        {
                            <div class="alert alert-danger">@updateModalError</div>
                        }
                        <p>Выберите процесс для изменения документа. Будет создан черновик новой версии.</p>
                        <div class="mb-3">
                            <label class="form-label">Бизнес-процесс</label>
                            <select class="form-select" @bind="selectedWorkflowId">
                                <option value="0">— выберите процесс —</option>
                                @foreach (var w in availableWorkflows)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseUpdateModal">Отмена</button>
                        <button type="button" class="btn btn-primary" disabled="@(selectedWorkflowId == 0 || updateSubmitting)" @onclick="SubmitUpdate">Создать черновик</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @* Модальное окно версий *@
    @if (showVersionsModal && docForVersions != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">История версий: @docForVersions.Title</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseVersionsModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (isLoadingVersions)
                        {
                            <p>Загрузка...</p>
                        }
                        else if (documentVersions.Count == 0)
                        {
                            <p class="text-muted">Нет предыдущих версий.</p>
                        }
                        else
                        {
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Версия</th>
                                        <th>Название</th>
                                        <th>Дата архивации</th>
                                        <th>Файл</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in documentVersions)
                                    {
                                        <tr>
                                            <td>@v.VersionNumber</td>
                                            <td>@v.Title</td>
                                            <td>@v.ArchivedAt.ToLocalTime().ToString("g")</td>
                                            <td>
                                                <a class="btn btn-sm btn-outline-primary" href="@($"/api/documents/versions/{v.Id}/download")" target="_blank">Скачать</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseVersionsModal">Закрыть</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {

    private enum SortOption
    {
        TitleAsc,
        TitleDesc,
        CreatedAsc,
        CreatedDesc
    }
    private bool isAdmin = false;
    private bool showDeleted = false;
    private bool isLoading = true;
    private string? loadError;
    private List<Document> documents = new();
    private Employee? currentEmployee;
    private bool showUpdateModal;
    private Document? docToUpdate;
    private List<Workflow> availableWorkflows = new();
    private int selectedWorkflowId;
    private string? updateModalError;
    private bool updateSubmitting;
    private bool showVersionsModal;
    private Document? docForVersions;
    private List<DocumentVersion> documentVersions = new();
    private bool isLoadingVersions;
    private List<DocumentType> documentTypes = new();
    private int selectedDocumentTypeId = 0;
    private string searchTitle = "";
    private SortOption selectedSortOption = SortOption.CreatedDesc;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAdmin = await CurrentUserService.IsAdminAsync();
            currentEmployee = await CurrentUserService.GetCurrentEmployeeAsync();
            documentTypes = await DocumentTypeService.GetAllAsync();
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }
    private async Task RestoreDoc(Document doc)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Восстановить документ '{doc.Title}'?"))
        {
            await DocumentService.RestoreDocumentAsync(doc.Id);
            await LoadDocuments();
        }
    }
    private async Task DeleteDoc(Document doc)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить документ '{doc.Title}'?"))
        {
            await DocumentService.DeleteDocumentAsync(doc.Id);
            await LoadDocuments();
        }
    }
    private void ResetFilters()
    {
        selectedDocumentTypeId = 0;
        searchTitle = "";
        selectedSortOption = SortOption.CreatedDesc;
    }
    private async Task ToggleShowDeleted(ChangeEventArgs e)
    {
        showDeleted = (bool)(e.Value ?? false);
        await LoadDocuments();
    }
    private async Task LoadDocuments()
    {
        isLoading = true;
        loadError = null;
        try
        {
            documents = await DocumentService.GetApprovedDocumentsAsync(showDeleted);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
    private List<Document> sortedDocuments
    {
        get
        {
            var filtered = filteredDocuments;
            return selectedSortOption switch
            {
                SortOption.TitleAsc => filtered.OrderBy(d => d.Title).ToList(),
                SortOption.TitleDesc => filtered.OrderByDescending(d => d.Title).ToList(),
                SortOption.CreatedAsc => filtered.OrderBy(d => d.CreatedAt).ToList(),
                SortOption.CreatedDesc => filtered.OrderByDescending(d => d.CreatedAt).ToList(),
                _ => filtered
            };
        }
    }
    private async Task OpenVersionsModal(Document doc)
    {
        docForVersions = doc;
        showVersionsModal = true;
        isLoadingVersions = true;
        try
        {
            documentVersions = await DocumentService.GetApprovedDocumentVersionsAsync(doc.Id);
        }
        catch (Exception ex)
        {
            loadError = $"Ошибка загрузки версий: {ex.Message}";
        }
        finally
        {
            isLoadingVersions = false;
        }
    }

    private async Task OpenUpdateModal(Document doc)
    {
        if (currentEmployee == null) return;
        docToUpdate = doc;
        selectedWorkflowId = 0;
        updateModalError = null;

        try
        {
            // Получаем доступные для старта процессы и фильтруем по типу выбранного документа
            var allStartable = await WorkflowService.GetStartableWorkflowsAsync();
            availableWorkflows = allStartable.Where(w => w.DocumentTypeId == doc.DocumentTypeId).ToList();
            showUpdateModal = true;
        }
        catch (Exception ex)
        {
            loadError = $"Ошибка загрузки процессов: {ex.Message}";
        }
    }
    private List<Document> filteredDocuments => documents
    .Where(d => selectedDocumentTypeId == 0 || d.DocumentTypeId == selectedDocumentTypeId)
    .Where(d => string.IsNullOrWhiteSpace(searchTitle) || d.Title.Contains(searchTitle, StringComparison.OrdinalIgnoreCase))
    .ToList();
    private void CloseVersionsModal()
    {
        showVersionsModal = false;
        docForVersions = null;
    }
    private void CloseUpdateModal()
    {
        showUpdateModal = false;
        docToUpdate = null;
    }

    private async Task SubmitUpdate()
    {
        if (docToUpdate == null || currentEmployee == null || selectedWorkflowId == 0) return;

        updateSubmitting = true;
        updateModalError = null;
        try
        {
            var deptId = await CurrentUserService.GetDepartmentIdAsync();
            await DocumentService.StartEditApprovedDocumentAsync(docToUpdate.Id, selectedWorkflowId, currentEmployee.Id, deptId);

            showUpdateModal = false;
            // Перенаправляем пользователя в раздел процессов для продолжения работы с черновиком
            NavigationManager.NavigateTo("/Workflows");
        }
        catch (Exception ex)
        {
            updateModalError = ex.Message;
        }
        finally
        {
            updateSubmitting = false;
        }
    }
}