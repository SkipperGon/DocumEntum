@page "/Documents"
@rendermode InteractiveServer
@attribute [Authorize]
@using DocumEntum.Data
@using DocumEntum.Services
@using Microsoft.AspNetCore.Authorization
@inject IDocumentService DocumentService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<h3>Документы</h3>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (documents.Count == 0)
{
    <p>Нет доступных документов.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Тип</th>
                <th>Статус</th>
                <th>Автор</th>
                <th>Дата создания</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in documents)
            {
                <tr>
                    <td>@doc.Id</td>
                    <td>@doc.Title</td>
                    <td>@doc.DocumentType?.Name</td>
                    <td>@doc.CurrentState?.Name</td>
                    <td>@doc.Author?.FullName</td>
                    <td>@doc.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => ViewDocument(doc.Id)">Просмотр</button>
                        @if (isAdmin)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteDocument(doc)">Удалить</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (isEmployee)
{
    <button class="btn btn-primary mt-3" @onclick="CreateDocument">➕ Создать документ</button>
}

@code {
    private List<Document> documents = new();
    private bool isLoading = true;
    private bool isAdmin = false;
    private bool isEmployee = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadDocuments();

    private async Task LoadDocuments()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            documents = await DocumentService.GetAccessibleDocumentsAsync();
            isAdmin = await CurrentUserService.IsAdminAsync();
            isEmployee = await CurrentUserService.GetCurrentEmployeeAsync() != null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки документов: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewDocument(int id) => NavigationManager.NavigateTo($"/Document/{id}");
    private void CreateDocument() => NavigationManager.NavigateTo("/Document/Create");

    private async Task DeleteDocument(Document doc)
    {
        if (!isAdmin) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить документ '{doc.Title}'?");
        if (!confirmed) return;

        try
        {
            await DocumentService.DeleteDocumentAsync(doc.Id);
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка удаления: {ex.Message}";
        }
    }
}