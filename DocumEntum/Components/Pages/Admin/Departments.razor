@page "/Admin/Departments"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using DocumEntum.Data
@using DocumEntum.Services
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject IOrganizationService OrgService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Управление отделами</h3>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="() => OpenModal(null, null)">➕ Добавить корневой отдел</button>

    @if (rootDepartments.Any())
    {
        <ul class="department-tree">
            @foreach (var root in rootDepartments)
            {
                <DepartmentNode Department="root"
                                Children="root.Children?.ToList() ?? new List<Department>()"
                                OnEdit="(dept) => OpenModal(dept,null)"
                                OnAddChild="(dept) => OpenModal(null,dept)"
                                OnManagePositions="OpenPositionsModal"
                                OnDelete="ConfirmDelete" />
            }
        </ul>
    }
    else
    {
        <p>Нет отделов. Создайте первый отдел.</p>
    }
}

@* Модальное окно для отдела (создание/редактирование) *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingDepartment == null ? "Новый отдел" : "Редактирование отдела")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="editModel" OnValidSubmit="SaveDepartment">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Название</label>
                            <InputText @bind-Value="editModel.Name" class="form-control bg-dark text-white border-secondary" />
                            <ValidationMessage For="() => editModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Родительский отдел</label>
                            <InputSelect @bind-Value="editModel.ParentId" class="form-control bg-dark text-white border-secondary">
                                <option value="">— Корневой отдел —</option>
                                @foreach (var dept in allDepartmentsFlat)
                                {
                                    if (editingDepartment != null && (dept.Id == editingDepartment.Id || IsDescendantOf(dept.Id, editingDepartment.Id)))
                                        continue;
                                    <option value="@dept.Id">@dept.Name</option>
                                }
                            </InputSelect>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* Модальное окно для управления должностями отдела *@
@if (showPositionsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">Должности отдела: @selectedDepartment?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePositionsModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingPositions)
                    {
                        <p>Загрузка должностей...</p>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success mb-2" @onclick="() => OpenPositionEditModal(null)">➕ Добавить должность</button>
                        <table class="table table-sm table-dark">
                            <thead>
                                <tr><th>Название</th><th>Описание</th><th>Действия</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var pos in departmentPositions)
                                {
                                    <tr>
                                        <td>@pos.Title</td>
                                        <td>@pos.Description</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary" @onclick="() => OpenPositionEditModal(pos)">✏️</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeletePosition(pos)">🗑️</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePositionsModal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}

@* Модальное окно для добавления/редактирования должности *@
@if (showPositionEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingPosition == null ? "Новая должность" : "Редактирование должности")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePositionEditModal"></button>
                </div>
                <EditForm Model="positionEditModel" OnValidSubmit="SavePosition">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Название</label>
                            <InputText @bind-Value="positionEditModel.Title" class="form-control bg-dark text-white border-secondary" />
                            <ValidationMessage For="() => positionEditModel.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Описание</label>
                            <InputText @bind-Value="positionEditModel.Description" class="form-control bg-dark text-white border-secondary" />
                        </div>
                        @if (!string.IsNullOrEmpty(positionErrorMessage))
                        {
                            <div class="alert alert-danger">@positionErrorMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ClosePositionEditModal">Отмена</button>
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Department> allDepartmentsFlat = new();
    private List<Department> rootDepartments = new();
    private bool isLoading = true;
    private bool showModal;
    private Department? editingDepartment;
    private Department? parentForNew;
    private DepartmentEditModel editModel = new();
    private string? errorMessage;

    // Переменные для управления должностями
    private bool showPositionsModal;
    private bool isLoadingPositions;
    private Department? selectedDepartment;
    private List<Position> departmentPositions = new();
    private bool showPositionEditModal;
    private Position? editingPosition;
    private PositionEditModel positionEditModel = new();
    private string? positionErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            allDepartmentsFlat = await OrgService.GetAllDepartmentsFlatAsync();
            BuildTree();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildTree()
    {
        var lookup = allDepartmentsFlat.ToDictionary(d => d.Id);
        foreach (var dept in allDepartmentsFlat)
        {
            dept.Children = new List<Department>();
        }
        rootDepartments.Clear();
        foreach (var dept in allDepartmentsFlat)
        {
            if (dept.ParentId == null)
                rootDepartments.Add(dept);
            else if (lookup.TryGetValue(dept.ParentId.Value, out var parent))
                parent.Children.Add(dept);
        }
    }

    private void OpenModal(Department? editDept, Department? parent)
    {
        editingDepartment = editDept;
        parentForNew = parent;
        editModel = new DepartmentEditModel();

        if (editDept != null)
        {
            editModel.Name = editDept.Name;
            editModel.ParentId = editDept.ParentId;
        }
        else
        {
            editModel.ParentId = parent?.Id;
        }

        showModal = true;
        errorMessage = null;
        StateHasChanged();
    }

    private async Task SaveDepartment()
    {
        errorMessage = null;

        try
        {
            if (editingDepartment == null)
            {
                var newDept = new Department
                {
                    Name = editModel.Name,
                    ParentId = editModel.ParentId
                };
                await OrgService.CreateDepartmentAsync(newDept.Name, newDept.ParentId);
            }
            else
            {
                if (editModel.ParentId == editingDepartment.Id)
                {
                    errorMessage = "Отдел не может быть родителем самого себя.";
                    return;
                }
                if (editModel.ParentId.HasValue && IsDescendantOf(editModel.ParentId.Value, editingDepartment.Id))
                {
                    errorMessage = "Нельзя переместить отдел в его собственный подотдел.";
                    return;
                }

                editingDepartment.Name = editModel.Name;
                editingDepartment.ParentId = editModel.ParentId;
                await OrgService.UpdateDepartmentAsync(editingDepartment);
            }

            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка сохранения: {ex.Message}";
        }
    }

    private async Task ConfirmDelete(Department dept)
    {
        var canDelete = await OrgService.CanDeleteDepartmentAsync(dept.Id);
        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "Невозможно удалить отдел. У него есть подотделы, документы или сотрудники на должностях.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить отдел '{dept.Name}'?");
        if (confirmed)
        {
            await OrgService.DeleteDepartmentAsync(dept.Id);
            await LoadData();
        }
    }


    private bool IsDescendantOf(int possibleDescendantId, int ancestorId)
    {
        var current = allDepartmentsFlat.FirstOrDefault(d => d.Id == possibleDescendantId);
        while (current != null && current.ParentId != null)
        {
            if (current.ParentId == ancestorId) return true;
            current = allDepartmentsFlat.FirstOrDefault(d => d.Id == current.ParentId);
        }
        return false;
    }

    private void CloseModal()
    {
        showModal = false;
        editingDepartment = null;
        parentForNew = null;
        editModel = new DepartmentEditModel();
        errorMessage = null;
    }

    // ========== Управление должностями ==========
    private async Task OpenPositionsModal(Department dept)
    {
        selectedDepartment = dept;
        showPositionsModal = true;
        await LoadPositions();
    }

    private async Task LoadPositions()
    {
        if (selectedDepartment == null) return;
        isLoadingPositions = true;
        try
        {
            departmentPositions = await OrgService.GetPositionsByDepartmentAsync(selectedDepartment.Id);
        }
        catch (Exception ex)
        {
            positionErrorMessage = $"Ошибка загрузки должностей: {ex.Message}";
        }
        finally
        {
            isLoadingPositions = false;
            StateHasChanged();
        }
    }

    private void OpenPositionEditModal(Position? pos)
    {
        editingPosition = pos;
        positionEditModel = new PositionEditModel();
        if (pos != null)
        {
            positionEditModel.Title = pos.Title;
            positionEditModel.Description = pos.Description;
        }
        showPositionEditModal = true;
        positionErrorMessage = null;
        StateHasChanged();
    }

    private async Task SavePosition()
    {
        positionErrorMessage = null;
        try
        {
            if (selectedDepartment == null) return;

            if (editingPosition == null)
            {
                await OrgService.CreatePositionAsync(selectedDepartment.Id, positionEditModel.Title, positionEditModel.Description);
            }
            else
            {
                editingPosition.Title = positionEditModel.Title;
                editingPosition.Description = positionEditModel.Description;
                await OrgService.UpdatePositionAsync(editingPosition);
            }
            await LoadPositions();
            ClosePositionEditModal();
        }
        catch (Exception ex)
        {
            positionErrorMessage = ex.Message;
        }
    }

    private async Task ConfirmDeletePosition(Position pos)
    {
        var canDelete = await OrgService.CanDeletePositionAsync(pos.Id);
        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "Нельзя удалить должность, на которую назначены сотрудники.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить должность '{pos.Title}'?");
        if (confirmed)
        {
            await OrgService.DeletePositionAsync(pos.Id);
            await LoadPositions();
        }
    }

    private void ClosePositionsModal()
    {
        showPositionsModal = false;
        selectedDepartment = null;
        departmentPositions.Clear();
        positionErrorMessage = null;
    }

    private void ClosePositionEditModal()
    {
        showPositionEditModal = false;
        editingPosition = null;
        positionEditModel = new PositionEditModel();
        positionErrorMessage = null;
    }

    // ========== Вспомогательные модели ==========
    public class DepartmentEditModel
    {
        [Required(ErrorMessage = "Название обязательно")]
        public string Name { get; set; } = "";
        public int? ParentId { get; set; }
    }

    public class PositionEditModel
    {
        [Required(ErrorMessage = "Название обязательно")]
        public string Title { get; set; } = "";
        public string? Description { get; set; }
    }
}

<style>
    .department-tree {
        list-style: none;
        padding-left: 0;
    }

        .department-tree ul {
            list-style: none;
            padding-left: 20px;
        }

    .department-item {
        margin: 5px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-group .btn {
        padding: 0 4px;
        font-size: 0.8rem;
    }
</style>