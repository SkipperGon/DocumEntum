@page "/Admin/Users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using DocumEntum.Data
@using DocumEntum.Services
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject ApplicationDbContext DbContext
@inject ICurrentUserService CurrentUserService
@inject IOrganizationService OrgService
@inject IJSRuntime JS

<h3>Управление пользователями</h3>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
else
{
    <table class="table table-dark table-striped">
        <thead>
            <tr><th>Логин</th><th>Имя</th><th>Email</th><th>Роль</th><th>Отдел / Должность</th><th>Действия</th></tr>
        </thead>
        <tbody>
            @foreach (var vm in userViewModels)
            {
                if (vm.IsSuperAdmin) continue;
                <tr>
                    <td>@vm.User.UserName</td>
                    <td>@(string.IsNullOrEmpty(vm.FullName) ? "-" : vm.FullName)</td>
                    <td>@vm.User.Email</td>
                    <td>@TranslateRole(vm.Role)</td>
                    <td>
                        @if (vm.Role == "Employee")
                        {
                            <span>@vm.DepartmentName / @vm.PositionName</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditUserAsync(vm.User)">Править</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(vm.User)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    
    </table>

    <button class="btn btn-success" @onclick="CreateUserAsync">Добавить пользователя</button>
}
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingUser == null ? "Новый пользователь" : "Редактирование")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="editModel" OnValidSubmit="SaveUser" FormName="user-edit-form">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Логин</label>
                            <InputText @bind-Value="editModel.UserName" class="form-control bg-dark text-white border-secondary" />
                            <ValidationMessage For="() => editModel.UserName" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="editModel.Email" class="form-control bg-dark text-white border-secondary" />
                            <ValidationMessage For="() => editModel.Email" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Пароль @(editingUser == null ? "" : "(оставьте пустым, чтобы не менять)")</label>
                            <InputText type="password" @bind-Value="editModel.Password" class="form-control bg-dark text-white border-secondary" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Роль</label>
                            <InputSelect @bind-Value="editModel.SelectedRole" @bind-Value:after="OnRoleChanged" class="form-control bg-dark text-white border-secondary">
                                <option value="">-- Выберите роль --</option>
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role">@TranslateRole(role)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => editModel.SelectedRole" class="text-danger" />
                        </div>

                        @if (editModel.SelectedRole == "Employee")
                        {
                            <div class="mb-3">
                                <label class="form-label">Отдел</label>
                                <InputSelect @bind-Value="editModel.DepartmentId" @bind-Value:after="OnDepartmentChanged" class="form-control bg-dark text-white border-secondary">
                                    <option value="">-- Выберите отдел --</option>
                                    @foreach (var dept in departments)
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Должность (необязательно)</label>
                                <InputSelect @bind-Value="editModel.PositionId" class="form-control bg-dark text-white border-secondary">
                                    <option value="">-- Не выбрана --</option>
                                    @foreach (var pos in availablePositions)
                                    {
                                        <option value="@pos.Id">@pos.Title</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Полное имя сотрудника</label>
                                <InputText @bind-Value="editModel.FullName" class="form-control bg-dark text-white border-secondary" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-2">@errorMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                        <button type="submit" class="btn btn-primary">@(editingUser == null ? "Создать" : "Сохранить")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<UserViewModel> userViewModels = new();
    private bool showModal;
    private ApplicationUser? editingUser;
    private UserEditModel editModel = new();
    private List<string> allRoles = new();
    private List<string> availableRoles = new();
    private string? errorMessage;
    private string? loadError;
    private bool isLoading = true;

    private List<Department> departments = new();
    private List<Position> availablePositions = new();

    private class UserViewModel
    {
        public ApplicationUser User { get; set; } = null!;
        public string Role { get; set; } = "";
        public bool IsSuperAdmin => Role == "SuperAdmin";
        public string? DepartmentName { get; set; }
        public string? PositionName { get; set; }
        public string? FullName { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRolesAsync();
            await LoadDepartmentsAsync();
            await LoadUsersOptimizedAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Ошибка загрузки данных: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadRolesAsync()
    {
        allRoles = await RoleManager.Roles.Select(r => r.Name!).ToListAsync();
        availableRoles = allRoles.Where(r => r != "SuperAdmin").ToList();
    }

    private async Task LoadDepartmentsAsync()
    {
        departments = await OrgService.GetAllDepartmentsFlatAsync();
    }

    private async Task LoadUsersOptimizedAsync()
    {
        var users = await UserManager.Users.ToListAsync();

        var userRolesQuery = from ur in DbContext.UserRoles
                             join r in DbContext.Roles on ur.RoleId equals r.Id
                             select new { ur.UserId, RoleName = r.Name! };

        var userRolesList = await userRolesQuery.ToListAsync();
        var rolesDict = userRolesList
            .GroupBy(ur => ur.UserId)
            .ToDictionary(g => g.Key, g => g.First().RoleName);

        var employeePositions = await DbContext.EmployeePositions
            .Include(ep => ep.Employee)
            .Include(ep => ep.Position)
                .ThenInclude(p => p.Department)
            .Where(ep => ep.EndDate == null)
            .ToListAsync();

        var userPositions = employeePositions.ToDictionary(ep => ep.Employee.UserId, ep => ep);

        userViewModels = users.Select(user =>
        {
            var role = rolesDict.GetValueOrDefault(user.Id, "");
            var pos = userPositions.GetValueOrDefault(user.Id);
            return new UserViewModel
            {
                User = user,
                Role = role,
                DepartmentName = pos?.Position?.Department?.Name,
                PositionName = pos?.Position?.Title,
                FullName = pos?.Employee?.FullName
            };
        }).ToList();
    }

    private async Task CreateUserAsync()
    {
        editingUser = null;
        editModel = new UserEditModel();
        availablePositions.Clear();
        showModal = true;
        errorMessage = null;
        StateHasChanged();
    }

    private async Task EditUserAsync(ApplicationUser user)
    {
        if (await IsSuperAdmin(user))
        {
            errorMessage = "Редактирование главного администратора запрещено.";
            return;
        }

        editingUser = user;
        var roles = await UserManager.GetRolesAsync(user);
        var currentRole = roles.FirstOrDefault() ?? "";
        var employee = await DbContext.Employees.FirstOrDefaultAsync(e => e.UserId == user.Id);

        EmployeePosition? employeePosition = null;
        if (employee != null)
        {
            employeePosition = await DbContext.EmployeePositions
                .Include(ep => ep.Position)
                .FirstOrDefaultAsync(ep => ep.EmployeeId == employee.Id && ep.EndDate == null);
        }

        editModel = new UserEditModel
        {
            UserName = user.UserName ?? "",
            Email = user.Email,
            Password = "",
            SelectedRole = currentRole,
            FullName = employee?.FullName ?? "",
            DepartmentId = employeePosition?.Position?.DepartmentId,
            PositionId = employeePosition?.PositionId
        };

        if (currentRole == "Employee" && editModel.DepartmentId.HasValue)
        {
            await LoadPositionsByDepartment(editModel.DepartmentId.Value);
        }
        else
        {
            availablePositions.Clear();
        }
        StateHasChanged();
        showModal = true;
        errorMessage = null;
    }

    private async Task OnRoleChanged()
    {
        var newRole = editModel.SelectedRole;
        if (newRole != "Employee")
        {
            editModel.DepartmentId = null;
            editModel.PositionId = null;
            availablePositions.Clear();
        }
        else
        {
            if (editModel.DepartmentId.HasValue && editModel.DepartmentId.Value > 0)
            {
                await LoadPositionsByDepartment(editModel.DepartmentId.Value);
            }
        }
    }

    private async Task OnDepartmentChanged()
    {
        var deptId = editModel.DepartmentId;
        if (deptId.HasValue && deptId.Value > 0)
        {
            await LoadPositionsByDepartment(deptId.Value);
            editModel.PositionId = null;
        }
        else
        {
            availablePositions.Clear();
            editModel.PositionId = null;
        }
    }

    private async Task LoadPositionsByDepartment(int departmentId)
    {
        availablePositions = await OrgService.GetPositionsByDepartmentAsync(departmentId);
    }

    private async Task SaveUser()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(editModel.UserName))
        {
            errorMessage = "Логин обязателен";
            return;
        }

        if (string.IsNullOrWhiteSpace(editModel.SelectedRole))
        {
            errorMessage = "Необходимо выбрать роль";
            return;
        }

        if (editingUser == null && string.IsNullOrWhiteSpace(editModel.Password))
        {
            errorMessage = "Пароль обязателен для нового пользователя";
            return;
        }

        if (editModel.SelectedRole == "SuperAdmin")
        {
            errorMessage = "Назначение роли гл.администратора через этот интерфейс запрещено.";
            return;
        }

        // Для Employee не требуется обязательный выбор должности или отдела.
        // Отдел нужен только для фильтрации списка должностей, но не обязателен для сохранения.
        // Если должность не выбрана (PositionId == null) – это допустимо.

        try
        {
            if (editingUser == null)
            {
                // Создание нового пользователя
                var newUser = new ApplicationUser
                {
                    UserName = editModel.UserName,
                    Email = string.IsNullOrEmpty(editModel.Email) ? null : editModel.Email
                };

                var createResult = await UserManager.CreateAsync(newUser, editModel.Password);
                if (!createResult.Succeeded)
                {
                    errorMessage = string.Join(", ", createResult.Errors.Select(e => e.Description));
                    return;
                }

                var roleResult = await UserManager.AddToRoleAsync(newUser, editModel.SelectedRole);
                if (!roleResult.Succeeded)
                {
                    errorMessage = string.Join(", ", roleResult.Errors.Select(e => e.Description));
                    await UserManager.DeleteAsync(newUser);
                    return;
                }

                if (editModel.SelectedRole == "Employee")
                {
                    var employee = new Employee
                    {
                        UserId = newUser.Id,
                        FullName = editModel.FullName ?? editModel.UserName,
                        Email = newUser.Email
                    };
                    DbContext.Employees.Add(employee);
                    await DbContext.SaveChangesAsync();
                    // PositionId может быть null
                    await OrgService.AssignEmployeeToPositionAsync(employee.Id, editModel.PositionId);
                }
            }
            else
            {
                // Редактирование существующего
                if (await IsSuperAdmin(editingUser))
                {
                    errorMessage = "Редактирование главного администратора запрещено";
                    return;
                }

                editingUser.UserName = editModel.UserName;
                editingUser.Email = string.IsNullOrEmpty(editModel.Email) ? null : editModel.Email;
                var updateResult = await UserManager.UpdateAsync(editingUser);
                if (!updateResult.Succeeded)
                {
                    errorMessage = string.Join(", ", updateResult.Errors.Select(e => e.Description));
                    return;
                }

                if (!string.IsNullOrWhiteSpace(editModel.Password))
                {
                    if (await UserManager.HasPasswordAsync(editingUser))
                        await UserManager.RemovePasswordAsync(editingUser);
                    var addPasswordResult = await UserManager.AddPasswordAsync(editingUser, editModel.Password);
                    if (!addPasswordResult.Succeeded)
                    {
                        errorMessage = string.Join(", ", addPasswordResult.Errors.Select(e => e.Description));
                        return;
                    }
                }

                var currentRoles = await UserManager.GetRolesAsync(editingUser);
                if (currentRoles.FirstOrDefault() != editModel.SelectedRole)
                {
                    if (currentRoles.Any())
                        await UserManager.RemoveFromRolesAsync(editingUser, currentRoles);
                    await UserManager.AddToRoleAsync(editingUser, editModel.SelectedRole);
                }

                var existingEmployee = await DbContext.Employees.FirstOrDefaultAsync(e => e.UserId == editingUser.Id);
                if (editModel.SelectedRole == "Employee")
                {
                    if (existingEmployee == null)
                    {
                        existingEmployee = new Employee
                        {
                            UserId = editingUser.Id,
                            FullName = editModel.FullName ?? editingUser.UserName,
                            Email = editingUser.Email
                        };
                        DbContext.Employees.Add(existingEmployee);
                        await DbContext.SaveChangesAsync();
                    }
                    else
                    {
                        existingEmployee.FullName = editModel.FullName ?? existingEmployee.FullName;
                        existingEmployee.Email = editingUser.Email;
                        existingEmployee.IsActive = true;
                        await DbContext.SaveChangesAsync();
                    }

                    var currentPosition = await DbContext.EmployeePositions
                        .FirstOrDefaultAsync(ep => ep.EmployeeId == existingEmployee.Id && ep.EndDate == null);

                    if (currentPosition == null)
                    {
                        // PositionId может быть null
                        await OrgService.AssignEmployeeToPositionAsync(existingEmployee.Id, editModel.PositionId);
                    }
                    else if (currentPosition.PositionId != editModel.PositionId)
                    {
                        currentPosition.EndDate = DateTime.UtcNow;
                        await OrgService.AssignEmployeeToPositionAsync(existingEmployee.Id, editModel.PositionId);
                    }
                }
                else if (existingEmployee != null)
                {
                    var positions = await DbContext.EmployeePositions.Where(ep => ep.EmployeeId == existingEmployee.Id).ToListAsync();
                    DbContext.EmployeePositions.RemoveRange(positions);
                    DbContext.Employees.Remove(existingEmployee);
                    await DbContext.SaveChangesAsync();
                }
            }

            showModal = false;
            await LoadUsersOptimizedAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка сохранения пользователя: {ex.Message}";
        }
    }

    private async Task DeleteUser(ApplicationUser user)
    {
        try
        {
            if (await IsSuperAdmin(user))
            {
                errorMessage = "Удаление главного администратора запрещено.";
                return;
            }

            // Запрос подтверждения
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить пользователя '{user.UserName}'?");
            if (!confirmed) return;

            var emp = await DbContext.Employees.FirstOrDefaultAsync(e => e.UserId == user.Id);
            if (emp != null)
            {
                var positions = await DbContext.EmployeePositions.Where(ep => ep.EmployeeId == emp.Id).ToListAsync();
                DbContext.EmployeePositions.RemoveRange(positions);
                DbContext.Employees.Remove(emp);
                await DbContext.SaveChangesAsync();
            }

            var result = await UserManager.DeleteAsync(user);
            if (result.Succeeded)
            {
                await LoadUsersOptimizedAsync();
                StateHasChanged();
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка удаления пользователя: {ex.Message}";
        }
    }

    private async Task<bool> IsSuperAdmin(ApplicationUser user)
    {
        return await UserManager.IsInRoleAsync(user, "SuperAdmin");
    }

    private string TranslateRole(string roleEn) => roleEn switch
    {
        "Admin" => "Администратор",
        "Employee" => "Сотрудник",
        "SuperAdmin" => "Главный администратор",
        _ => roleEn
    };

    private void CloseModal()
    {
        showModal = false;
        editingUser = null;
        errorMessage = null;
        editModel = new UserEditModel();
        availablePositions.Clear();
    }

    public class UserEditModel
    {
        [Required(ErrorMessage = "Логин обязателен")]
        public string UserName { get; set; } = "";

        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string? Email { get; set; }

        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Роль обязательна")]
        public string SelectedRole { get; set; } = "";
        // для фильтрации списка должностей
        public int? DepartmentId { get; set; }   
        public int? PositionId { get; set; } 
    }
}